        <UnitName Value="wfc_package"/>
      </Item1>
      <Item2>
        <Filename Value="src/wfc.pas"/>
        <UnitName Value="wfc"/>
      </Item2>
    </Files>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
