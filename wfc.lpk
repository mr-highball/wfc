<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <Name Value="wfc_package"/>
    <Type Value="RunTimeOnly"/>
    <AutoUpdate Value="Manually"/>
    <Author Value="mr-highball"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="src"/>
        <UnitOutputDirectory Value="build/lazarus/package/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Wave Function Collapse and multi-pass constraint generation library"/>
